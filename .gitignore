# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Build output (DerivedData, test binaries, auval logs)
build/
DerivedData/
*.log
logpid

# Xcode project is generated by XcodeGen from project.yml (`xcodegen generate`)
*.xcodeproj/
*.xcworkspace/

# Xcode user state (in case the project above is ever committed)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Archives / exports
*.ipa
*.dSYM.zip
*.dSYM/
*.xcarchive/

# IDEs
.idea/
.vscode/
*.swp
*~

# Test audio: large (~166 MB) third-party WAVs with attribution requirements.
# SOURCES.txt lists where to download them.
TestAudio/*.wav
!TestAudio/SOURCES.txt

# Local configuration (signing team, identifiers); see .env.example
.env
