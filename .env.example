# Copy to .env and fill in. .env is gitignored; scripts/make-pkg.sh loads it.

# Apple Developer team ID (10 characters, see developer.apple.com → Membership)
TEAM_ID=XXXXXXXXXX

# Reverse-DNS prefix for identifiers
BUNDLE_ID_PREFIX=com.example

# Package identifier (default: $BUNDLE_ID_PREFIX.nomoreeq.pkg)
#PKG_ID=com.example.nomoreeq.pkg

# notarytool keychain profile; when set, the app and pkg are notarized and stapled
#NOTARY_PROFILE=notary

# Installer signing identity (default: first "Developer ID Installer" in the keychain)
#INSTALLER_ID="Developer ID Installer: Your Name (XXXXXXXXXX)"
